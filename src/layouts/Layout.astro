---
import '../styles/xp.css';
import favicon from '../assets/iconos_xp/123.ico';

interface Props {
  title?: string;
}

const { title = 'Mi Portafolio - Emilio XP' } = Astro.props;
const faviconSrc = typeof favicon === 'string' ? favicon : favicon.src;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portafolio de Carlos Emilio Molas Martínez, desarrollador de software, QA y analista funcional." />
    <link rel="icon" type="image/x-icon" href={faviconSrc} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
