---
import Window from './Window.astro';
import pcIcon from '../assets/iconos_xp/123.ico';
import folderIcon from '../assets/iconos_xp/160.ico';
import mailIcon from '../assets/iconos_xp/163.ico';
import internetIcon from '../assets/iconos_xp/106.ico';
import musicIcon from '../assets/iconos_xp/306.ico';
import recycleIcon from '../assets/iconos_xp/258.ico';
import toolsIcon from '../assets/iconos_xp/330.ico';

const assetSrc = (asset: string | { src: string }) => (typeof asset === 'string' ? asset : asset.src);
const pcIconSrc = assetSrc(pcIcon);
const folderIconSrc = assetSrc(folderIcon);
const mailIconSrc = assetSrc(mailIcon);
const internetIconSrc = assetSrc(internetIcon);
const musicIconSrc = assetSrc(musicIcon);
const recycleIconSrc = assetSrc(recycleIcon);
const toolsIconSrc = assetSrc(toolsIcon);

const desktopItems = [
  { id: 'about', label: 'Mi PC', sublabel: 'Sobre mí', icon: pcIconSrc },
  { id: 'proyectos', label: 'Mis proyectos', icon: folderIconSrc },
  { id: 'contacto', label: 'Contacto', icon: mailIconSrc },
  { id: 'internet', label: 'Internet', icon: internetIconSrc },
  { id: 'musica', label: 'Mi música', icon: musicIconSrc },
  { id: 'papelera', label: 'Papelera', icon: recycleIconSrc },
];
---

<div class="desktop">
  <div class="desktop-icons">
    {
      desktopItems.map((item) => (
        <button class="desktop-icon" data-open={item.id} type="button" aria-label={`Abrir ${item.label}`}>
          <img class="desktop-icon-img" src={item.icon} alt="" loading="eager" />
          <span class="desktop-icon-label">
            {item.label}
            {item.sublabel && <small>{item.sublabel}</small>}
          </span>
        </button>
      ))
    }
  </div>

  <Window id="about" title="Mi PC - Sobre mí" icon={pcIconSrc} width={560} height={370} top={62} left={154} hidden>
    <section class="xp-intro">
      <img src={pcIconSrc} alt="" />
      <div>
        <h2>Hola, soy Emilio</h2>
        <p>Desarrollador web construyendo experiencias con una mezcla de nostalgia, detalle visual y código limpio.</p>
      </div>
    </section>
    <div class="xp-info-grid">
      <article>
        <strong>Sistema</strong>
        <span>Astro + componentes limpios</span>
      </article>
      <article>
        <strong>Interfaz</strong>
        <span>Emilio XP, fondo clásico y ventanas antiguas</span>
      </article>
      <article>
        <strong>Estado</strong>
        <span>Disponible para nuevos proyectos</span>
      </article>
    </div>
  </Window>

  <Window id="proyectos" title="C:\Mis Proyectos" icon={folderIconSrc} width={650} height={430} top={88} left={218} hidden>
    <h2>Proyectos</h2>
    <div class="project-list">
      <article>
        <img src={toolsIconSrc} alt="" />
        <div>
          <strong>Portafolio Emilio XP</strong>
          <p>Interfaz tipo escritorio con ventanas, barra de tareas, iconos y fondo local.</p>
        </div>
      </article>
      <article>
        <img src={folderIconSrc} alt="" />
        <div>
          <strong>Proyecto destacado</strong>
          <p>Espacio preparado para enlazar tu mejor trabajo, demo y repositorio.</p>
        </div>
      </article>
      <article>
        <img src={internetIconSrc} alt="" />
        <div>
          <strong>Experiencias web</strong>
          <p>Landing pages, apps interactivas y sitios rápidos con foco en UI.</p>
        </div>
      </article>
    </div>
  </Window>

  <Window id="contacto" title="Correo - Contacto" icon={mailIconSrc} width={500} height={335} top={114} left={282} hidden>
    <h2>Contacto</h2>
    <div class="contact-list">
      <a href="mailto:tunombre@ejemplo.com">tunombre@ejemplo.com</a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="https://github.com/" target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <p class="xp-note">Actualiza estos enlaces con tus perfiles reales cuando quieras dejarlo listo para publicar.</p>
  </Window>

  <Window id="internet" title="Navegador - Internet" icon={internetIconSrc} width={540} height={360} top={78} left={330} hidden>
    <h2>Internet</h2>
    <p>Accesos rápidos a redes, demos y recursos personales.</p>
    <div class="browser-bar">
      <span>Dirección</span>
      <code>https://tu-portafolio.dev</code>
    </div>
    <div class="link-grid">
      <a href="https://github.com/" target="_blank" rel="noreferrer">Repositorio</a>
      <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">Perfil profesional</a>
      <a href="mailto:tunombre@ejemplo.com">Enviar email</a>
    </div>
  </Window>

  <Window id="musica" title="Reproductor - Mi música" icon={musicIconSrc} width={430} height={288} top={128} left={196} hidden>
    <h2>Mi música</h2>
    <div class="winamp-panel">
      <span>PLAY</span>
      <strong>coding-session.mp3</strong>
      <meter min="0" max="100" value="74">74%</meter>
    </div>
    <p>Un pequeño rincón para gustos, playlists o cualquier detalle personal que quieras sumar al portafolio.</p>
  </Window>

  <Window id="papelera" title="Papelera de reciclaje" icon={recycleIconSrc} width={480} height={320} top={144} left={258} hidden>
    <h2>Cosas que aprendí por el camino</h2>
    <ul class="xp-list">
      <li>Prototipos que enseñaron decisiones de producto.</li>
      <li>Detalles visuales que hacen que una interfaz se sienta viva.</li>
      <li>Ideas viejas recicladas en componentes nuevos.</li>
    </ul>
  </Window>
</div>

<script>
  // ---- Manejo de ventanas ----
  const windows = document.querySelectorAll<HTMLElement>('.xp-window');

  function getWindow(id: string) {
    return document.getElementById(`window-${id}`);
  }

  const taskbarApps = document.getElementById('taskbarApps');

  function setActiveTaskbarButton(id: string) {
    document.querySelectorAll('.taskbar-app').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-window-target') === id);
    });
  }

  function ensureTaskbarButton(win: HTMLElement) {
    if (!taskbarApps) return;
    const id = win.dataset.windowId;
    if (!id || taskbarApps.querySelector(`[data-window-target="${id}"]`)) return;

    const button = document.createElement('button');
    button.className = 'taskbar-app';
    button.type = 'button';
    button.dataset.windowTarget = id;

    const icon = win.dataset.windowIcon;
    if (icon) {
      const img = document.createElement('img');
      img.src = icon;
      img.alt = '';
      button.appendChild(img);
    }

    const label = document.createElement('span');
    label.textContent = win.dataset.windowTitle ?? id;
    button.appendChild(label);

    button.addEventListener('click', () => {
      if (win.hidden) {
        win.hidden = false;
      }
      bringToFront(win);
    });

    taskbarApps.appendChild(button);
  }

  function removeTaskbarButton(id: string) {
    taskbarApps?.querySelector(`[data-window-target="${id}"]`)?.remove();
  }

  function bringToFront(win: HTMLElement) {
    windows.forEach((w) => {
      w.classList.remove('active');
      const tb = w.querySelector('.xp-titlebar');
      if (tb) tb.classList.add('inactive');
    });
    win.classList.add('active');
    const tb = win.querySelector('.xp-titlebar');
    if (tb) tb.classList.remove('inactive');
    setActiveTaskbarButton(win.dataset.windowId ?? '');
  }

  function openWindow(id: string) {
    const win = getWindow(id);
    if (!win) return;
    win.hidden = false;
    ensureTaskbarButton(win);
    bringToFront(win);
  }

  function closeWindow(id: string) {
    const win = getWindow(id);
    if (!win) return;
    win.hidden = true;
    removeTaskbarButton(id);
  }

  // Abrir al hacer click en un icono del escritorio
  document.querySelectorAll<HTMLElement>('.desktop-icon').forEach((icon) => {
    icon.addEventListener('dblclick', () => {
      const id = icon.dataset.open;
      if (id) openWindow(id);
    });
    // Un solo click selecciona
    icon.addEventListener('click', (e) => {
      e.stopPropagation();
      document.querySelectorAll('.desktop-icon').forEach((i) => i.classList.remove('selected'));
      icon.classList.add('selected');
    });
  });

  // Click en el fondo deselecciona
  document.querySelector('.desktop')?.addEventListener('click', () => {
    document.querySelectorAll('.desktop-icon').forEach((i) => i.classList.remove('selected'));
  });

  // Botones de cada ventana (cerrar/minimizar/maximizar)
  document.querySelectorAll<HTMLButtonElement>('.xp-tb-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const action = btn.dataset.action;
      const win = btn.closest<HTMLElement>('.xp-window');
      if (!win) return;
      const id = win.dataset.windowId!;

      if (action === 'close') closeWindow(id);
      if (action === 'minimize') win.hidden = true;
      if (action === 'maximize') {
        if (win.dataset.maximized === 'true') {
          win.style.width = win.dataset.restoreWidth ?? '';
          win.style.height = win.dataset.restoreHeight ?? '';
          win.style.top = win.dataset.restoreTop ?? '';
          win.style.left = win.dataset.restoreLeft ?? '';
          win.dataset.maximized = 'false';
        } else {
          win.dataset.restoreWidth = win.style.width;
          win.dataset.restoreHeight = win.style.height;
          win.dataset.restoreTop = win.style.top;
          win.dataset.restoreLeft = win.style.left;
          win.style.width = 'min(92vw, 860px)';
          win.style.height = 'calc(100vh - 74px)';
          win.style.top = '14px';
          win.style.left = '4vw';
          win.dataset.maximized = 'true';
        }
      }
    });
  });

  // Foco al hacer click en cualquier parte de la ventana
  windows.forEach((w) => {
    w.addEventListener('mousedown', () => bringToFront(w));
  });

  // ---- Arrastrar ventanas ----
  let dragState: { win: HTMLElement; offsetX: number; offsetY: number } | null = null;

  document.querySelectorAll<HTMLElement>('[data-drag-handle]').forEach((handle) => {
    handle.addEventListener('mousedown', (e) => {
      const win = handle.closest<HTMLElement>('.xp-window');
      if (!win) return;
      const rect = win.getBoundingClientRect();
      dragState = {
        win,
        offsetX: e.clientX - rect.left,
        offsetY: e.clientY - rect.top,
      };
      bringToFront(win);
      e.preventDefault();
    });
  });

  window.addEventListener('mousemove', (e) => {
    if (!dragState) return;
    const { win, offsetX, offsetY } = dragState;
    if (win.dataset.maximized === 'true') return;
    const maxLeft = window.innerWidth - win.offsetWidth;
    const maxTop = window.innerHeight - win.offsetHeight - 32;
    const newLeft = Math.min(Math.max(0, e.clientX - offsetX), Math.max(0, maxLeft));
    const newTop = e.clientY - offsetY;
    win.style.left = `${newLeft}px`;
    win.style.top = `${Math.min(Math.max(0, newTop), Math.max(0, maxTop))}px`;
  });

  window.addEventListener('mouseup', () => {
    dragState = null;
  });
</script>
