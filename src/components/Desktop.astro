const mailIconSrc = assetSrc(mailIcon);
const internetIconSrc = assetSrc(internetIcon);
const musicIconSrc = assetSrc(musicIcon);
const recycleIconSrc = assetSrc(recycleIcon);
const toolsIconSrc = assetSrc(toolsIcon);
const codeIconSrc = assetSrc(codeIcon);
const mobileIconSrc = assetSrc(mobileIcon);
const gitIconSrc = assetSrc(gitIcon);
const runtimeIconSrc = assetSrc(runtimeIcon);
const apiIconSrc = assetSrc(apiIcon);
const qaIconSrc = assetSrc(qaIcon);
const performanceIconSrc = assetSrc(performanceIcon);
const databaseIconSrc = assetSrc(databaseIcon);
const dockerIconSrc = assetSrc(dockerIcon);
const designIconSrc = assetSrc(designIcon);
const diagramIconSrc = assetSrc(diagramIcon);
const docsIconSrc = assetSrc(docsIcon);
