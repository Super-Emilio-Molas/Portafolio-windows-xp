const devBrowserIconSrc = assetSrc(devBrowserIcon);
const generatedNewsFiles = import.meta.glob('../data/news.generated.json', { eager: true, import: 'default' });
const newsData = (Object.values(generatedNewsFiles)[0] ?? newsDataFallback) as typeof newsDataFallback;
const newsItems = newsData.items.slice(0, 12);
const newsUpdated = newsData.updatedAt.includes('T')
  ? new Intl.DateTimeFormat('es-PY', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(newsData.updatedAt))
  : newsData.updatedAt;

