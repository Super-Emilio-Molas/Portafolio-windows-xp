<script>
  // ---- Manejo de ventanas ----
  const desktop = document.querySelector<HTMLElement>('.desktop');
  const windows = document.querySelectorAll<HTMLElement>('.xp-window');
  const desktopIcons = document.querySelectorAll<HTMLElement>('.desktop-icon');
  const selectionBox = document.getElementById('selectionBox');
  const contextMenu = document.getElementById('contextMenu');
  const startButton = document.getElementById('startButton') as HTMLButtonElement | null;
  const startMenu = document.getElementById('startMenu');
  const coarsePointer = window.matchMedia('(pointer: coarse)').matches;

  function getWindow(id: string) {
    return document.getElementById(`window-${id}`);
  }

  const taskbarApps = document.getElementById('taskbarApps');

  function setActiveTaskbarButton(id: string) {
    document.querySelectorAll('.taskbar-app').forEach((btn) => {
      btn.classList.toggle('active', btn.getAttribute('data-window-target') === id);
    });
  }

  function ensureTaskbarButton(win: HTMLElement) {
    if (!taskbarApps) return;
    const id = win.dataset.windowId;
    if (!id || taskbarApps.querySelector(`[data-window-target="${id}"]`)) return;

    const button = document.createElement('button');
    button.className = 'taskbar-app';
    button.type = 'button';
    button.dataset.windowTarget = id;

    const icon = win.dataset.windowIcon;
    if (icon) {
      const img = document.createElement('img');
      img.src = icon;
      img.alt = '';
      button.appendChild(img);
    }

    const label = document.createElement('span');
    label.textContent = win.dataset.windowTitle ?? id;
    button.appendChild(label);

    button.addEventListener('click', () => {
      if (win.hidden) {
        win.hidden = false;
      }
      bringToFront(win);
    });

    taskbarApps.appendChild(button);
  }

  function removeTaskbarButton(id: string) {
    taskbarApps?.querySelector(`[data-window-target="${id}"]`)?.remove();
  }

  function bringToFront(win: HTMLElement) {
    windows.forEach((w) => {
      w.classList.remove('active');
      const tb = w.querySelector('.xp-titlebar');
      if (tb) tb.classList.add('inactive');
    });
    win.classList.add('active');
    const tb = win.querySelector('.xp-titlebar');
    if (tb) tb.classList.remove('inactive');
    setActiveTaskbarButton(win.dataset.windowId ?? '');
  }

  function getMaxWindowBounds(win: HTMLElement) {
    return {
      left: Math.max(0, window.innerWidth - win.offsetWidth),
      top: Math.max(0, window.innerHeight - win.offsetHeight - 32),
    };
  }

  function clampWindow(win: HTMLElement) {
    if (win.dataset.maximized === 'true') return;
    const bounds = getMaxWindowBounds(win);
    const left = Math.min(Math.max(0, parseFloat(win.style.left) || 0), bounds.left);
    const top = Math.min(Math.max(0, parseFloat(win.style.top) || 0), bounds.top);
    win.style.left = `${left}px`;
    win.style.top = `${top}px`;
  }

  function openWindow(id: string) {
    const win = getWindow(id);
    if (!win) return;
    win.hidden = false;
    ensureTaskbarButton(win);
    clampWindow(win);
    bringToFront(win);
    hideStartMenu();
    hideContextMenu();
  }

  function closeWindow(id: string) {
    const win = getWindow(id);
    if (!win) return;
    win.hidden = true;
    removeTaskbarButton(id);
  }

  function hideContextMenu() {
    if (contextMenu) contextMenu.hidden = true;
  }

  function showContextMenu(x: number, y: number, targetId = '') {
    if (!contextMenu || !desktop) return;
    contextMenu.dataset.target = targetId;
    contextMenu.hidden = false;
    const desktopRect = desktop.getBoundingClientRect();
    const menuRect = contextMenu.getBoundingClientRect();
    const left = Math.min(Math.max(0, x - desktopRect.left), desktopRect.width - menuRect.width - 4);
    const top = Math.min(Math.max(0, y - desktopRect.top), desktopRect.height - menuRect.height - 4);
    contextMenu.style.left = `${left}px`;
    contextMenu.style.top = `${top}px`;
  }

  function hideStartMenu() {
    if (!startMenu || !startButton) return;
    startMenu.hidden = true;
    startButton.classList.remove('active');
    startButton.setAttribute('aria-expanded', 'false');
  }

  function toggleStartMenu() {
    if (!startMenu || !startButton) return;
    const nextHidden = !startMenu.hidden;
    startMenu.hidden = nextHidden;
    startButton.classList.toggle('active', !nextHidden);
    startButton.setAttribute('aria-expanded', String(!nextHidden));
    hideContextMenu();
  }

  function clearIconSelection() {
    desktopIcons.forEach((icon) => icon.classList.remove('selected'));
  }

  function selectIcon(icon: HTMLElement, append = false) {
    if (!append) clearIconSelection();
    icon.classList.add('selected');
  }

  function selectedIconIds() {
    return [...desktopIcons]
      .filter((icon) => icon.classList.contains('selected'))
      .map((icon) => icon.dataset.open)
      .filter(Boolean) as string[];
  }

  // Abrir al hacer doble click en escritorio, o toque directo en pantallas táctiles.
  desktopIcons.forEach((icon) => {
    icon.addEventListener('dblclick', () => {
      const id = icon.dataset.open;
      if (id) openWindow(id);
    });
    icon.addEventListener('click', (e) => {
      e.stopPropagation();
      selectIcon(icon, e.ctrlKey || e.metaKey);
      hideContextMenu();
      hideStartMenu();
      if (coarsePointer) {
        const id = icon.dataset.open;
        if (id) openWindow(id);
      }
    });
    icon.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (!icon.classList.contains('selected')) selectIcon(icon);
      showContextMenu(e.clientX, e.clientY, icon.dataset.open ?? '');
    });
  });

  startButton?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleStartMenu();
  });

  startMenu?.querySelectorAll<HTMLButtonElement>('[data-open-start]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.openStart;
      if (id) openWindow(id);
    });
  });

  contextMenu?.querySelectorAll<HTMLButtonElement>('[data-context-action]').forEach((button) => {
    button.addEventListener('click', () => {
      const action = button.dataset.contextAction;
      const targetId = contextMenu.dataset.target;
      if (action === 'open') {
        const ids = targetId ? [targetId] : selectedIconIds();
        ids.forEach((id) => openWindow(id));
      }
      if (action === 'refresh') {
        clearIconSelection();
      }
      if (action === 'select-all') {
        desktopIcons.forEach((icon) => icon.classList.add('selected'));
      }
      if (action === 'properties') {
        openWindow('about');
      }
      hideContextMenu();
    });
  });

  // Click en el fondo deselecciona.
  desktop?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('.context-menu, .start-menu')) return;
    clearIconSelection();
    hideContextMenu();
    hideStartMenu();
  });

  desktop?.addEventListener('contextmenu', (e) => {
    if ((e.target as HTMLElement).closest('.xp-window, .desktop-icon, .context-menu, .start-menu')) return;
    e.preventDefault();
    showContextMenu(e.clientX, e.clientY);
  });

  // Botones de cada ventana (cerrar/minimizar/maximizar)
  document.querySelectorAll<HTMLButtonElement>('.xp-tb-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const action = btn.dataset.action;
      const win = btn.closest<HTMLElement>('.xp-window');
      if (!win) return;
      const id = win.dataset.windowId!;

      if (action === 'close') closeWindow(id);
      if (action === 'minimize') win.hidden = true;
      if (action === 'maximize') {
        if (win.dataset.maximized === 'true') {
          win.style.width = win.dataset.restoreWidth ?? '';
          win.style.height = win.dataset.restoreHeight ?? '';
          win.style.top = win.dataset.restoreTop ?? '';
          win.style.left = win.dataset.restoreLeft ?? '';
          win.dataset.maximized = 'false';
          clampWindow(win);
        } else {
          win.dataset.restoreWidth = win.style.width;
          win.dataset.restoreHeight = win.style.height;
          win.dataset.restoreTop = win.style.top;
          win.dataset.restoreLeft = win.style.left;
          win.style.width = 'calc(100vw - 16px)';
          win.style.height = 'calc(100vh - var(--taskbar-height) - 16px)';
          win.style.top = '8px';
          win.style.left = '8px';
          win.dataset.maximized = 'true';
        }
      }
    });
  });

  // Foco al hacer click en cualquier parte de la ventana
  windows.forEach((w) => {
    w.addEventListener('mousedown', () => bringToFront(w));
  });

  // ---- Arrastrar ventanas ----
  let dragState: { win: HTMLElement; offsetX: number; offsetY: number } | null = null;
  let resizeState: {
    win: HTMLElement;
    startX: number;
    startY: number;
    startWidth: number;
    startHeight: number;
  } | null = null;
  let selectState: {
    startX: number;
    startY: number;
    active: boolean;
  } | null = null;

  document.querySelectorAll<HTMLElement>('[data-drag-handle]').forEach((handle) => {
    function startDrag(e: MouseEvent | PointerEvent) {
      const win = handle.closest<HTMLElement>('.xp-window');
      if (!win) return;
      if (win.dataset.maximized === 'true') return;
      const rect = win.getBoundingClientRect();
      dragState = {
        win,
        offsetX: e.clientX - rect.left,
        offsetY: e.clientY - rect.top,
      };
      bringToFront(win);
      e.preventDefault();
    }

    handle.addEventListener('mousedown', startDrag);
    handle.addEventListener('pointerdown', startDrag);
  });

  document.querySelectorAll<HTMLElement>('[data-resize-handle]').forEach((handle) => {
    function startResize(e: MouseEvent | PointerEvent) {
      const win = handle.closest<HTMLElement>('.xp-window');
      if (!win || win.dataset.maximized === 'true') return;
      resizeState = {
        win,
        startX: e.clientX,
        startY: e.clientY,
        startWidth: win.offsetWidth,
        startHeight: win.offsetHeight,
      };
      bringToFront(win);
      e.preventDefault();
      e.stopPropagation();
    }

    handle.addEventListener('mousedown', startResize);
    handle.addEventListener('pointerdown', startResize);
  });

  function startDesktopSelection(e: MouseEvent | PointerEvent) {
    if (e.button !== 0) return;
    if (!desktop || selectState || dragState || resizeState) return;
    const target = e.target as HTMLElement;
    if (target.closest('.desktop-icon, .xp-window, .context-menu, .start-menu')) return;
    const rect = desktop.getBoundingClientRect();
    const withinDesktop =
      e.clientX >= rect.left &&
      e.clientX <= rect.right &&
      e.clientY >= rect.top &&
      e.clientY <= rect.bottom;
    if (!withinDesktop) return;
    selectState = {
      startX: e.clientX - rect.left,
      startY: e.clientY - rect.top,
      active: false,
    };
    hideContextMenu();
    hideStartMenu();
  }

  desktop?.addEventListener('mousedown', startDesktopSelection);
  desktop?.addEventListener('pointerdown', startDesktopSelection);
  document.addEventListener('mousedown', startDesktopSelection, true);
  document.addEventListener('pointerdown', startDesktopSelection, true);

  function movePointer(e: MouseEvent | PointerEvent) {
    if (dragState) {
      const { win, offsetX, offsetY } = dragState;
      if (win.dataset.maximized === 'true') return;
      const bounds = getMaxWindowBounds(win);
      const newLeft = Math.min(Math.max(0, e.clientX - offsetX), bounds.left);
      const newTop = e.clientY - offsetY;
      win.style.left = `${newLeft}px`;
      win.style.top = `${Math.min(Math.max(0, newTop), bounds.top)}px`;
      return;
    }

    if (resizeState) {
      const { win, startX, startY, startWidth, startHeight } = resizeState;
      const maxWidth = window.innerWidth - (parseFloat(win.style.left) || 0) - 8;
      const maxHeight = window.innerHeight - (parseFloat(win.style.top) || 0) - 8 - 34;
      const width = Math.min(Math.max(320, startWidth + e.clientX - startX), maxWidth);
      const height = Math.min(Math.max(200, startHeight + e.clientY - startY), maxHeight);
      win.style.width = `${width}px`;
      win.style.height = `${height}px`;
      return;
    }

    if (selectState && desktop && selectionBox) {
      const rect = desktop.getBoundingClientRect();
      const currentX = e.clientX - rect.left;
      const currentY = e.clientY - rect.top;
      const left = Math.min(selectState.startX, currentX);
      const top = Math.min(selectState.startY, currentY);
      const width = Math.abs(currentX - selectState.startX);
      const height = Math.abs(currentY - selectState.startY);

      if (width > 4 || height > 4) {
        selectState.active = true;
        selectionBox.hidden = false;
        selectionBox.style.left = `${left}px`;
        selectionBox.style.top = `${top}px`;
        selectionBox.style.width = `${width}px`;
        selectionBox.style.height = `${height}px`;

        const selectionRect = selectionBox.getBoundingClientRect();
        desktopIcons.forEach((icon) => {
          const iconRect = icon.getBoundingClientRect();
          const intersects =
            selectionRect.left < iconRect.right &&
            selectionRect.right > iconRect.left &&
            selectionRect.top < iconRect.bottom &&
            selectionRect.bottom > iconRect.top;
          icon.classList.toggle('selected', intersects);
        });
      }
    }
  }

  window.addEventListener('mousemove', movePointer);
  window.addEventListener('pointermove', movePointer);

  function endPointer() {
    dragState = null;
    resizeState = null;
    if (selectionBox) selectionBox.hidden = true;
    selectState = null;
  }

  window.addEventListener('mouseup', endPointer);
  window.addEventListener('pointerup', endPointer);
  window.addEventListener('pointercancel', endPointer);

  window.addEventListener('resize', () => {
    windows.forEach((win) => clampWindow(win));
  });
</script>
