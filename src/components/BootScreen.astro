---
// Pantalla de arranque estilo Emilio XP
const introMusicFiles = import.meta.glob('../assets/music/musicaintroxp.{mp3,wav,ogg,m4a}', {
  eager: true,
  import: 'default',
  query: '?url',
});
const introMusicSrc = Object.values(introMusicFiles)[0] as string | undefined;
---

<div class="boot-screen" id="bootScreen">
  <div class="boot-logo" aria-label="Emilio XP">
    <span class="boot-brand">Emilio</span>
    <span class="boot-xp">xp</span>
    <small>professional</small>
  </div>

  <div class="boot-bar">
    <div class="boot-bar-blocks" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>

  <div class="boot-footer">
    <strong>Emilio XP</strong><br />
    Portfolio operating system
  </div>

  {introMusicSrc && <audio id="introMusic" src={introMusicSrc} preload="auto"></audio>}
</div>

<script>
  // Oculta la pantalla de arranque al terminar y muestra el escritorio.
  window.addEventListener('load', () => {
    const introMusic = document.getElementById('introMusic') as HTMLAudioElement | null;
    if (introMusic) {
      introMusic.volume = 0.35;
      introMusic.play().catch(() => {
        // Algunos navegadores bloquean audio sin interacción previa.
      });
    }

    setTimeout(() => {
      const boot = document.getElementById('bootScreen');
      const desktop = document.querySelector('.desktop') as HTMLElement | null;
      if (boot) boot.classList.add('hidden');
      if (desktop) desktop.classList.add('visible');
      // Elimina del DOM después de la transición
      setTimeout(() => boot?.remove(), 900);
    }, 3600);
  });
</script>
